# Settings는 루트 .env를 읽습니다. os.getenv·셸·시험 스크립트의 값은 필요할 때 별도로 export합니다.
# 비밀값은 모두 비워 둡니다. 실제 .env를 복사하거나 로그에 출력하지 마세요.

# 판단 AI와 글쓰기 보조
AI_API_KEY= # 판단 AI LIVE 인증 키; 기본 빈 값; 비밀
AI_NAME=Decision AI # 백엔드·Vite 공통 표시명; 기본 Decision AI; 비밀 아님
AI_MODEL=jev-1.13.0 # 판단 AI 모델 ID; 기본 jev-1.13.0; 비밀 아님
AI_MODE=live # 판단 AI 연결 live/mock; 기본 live; 비밀 아님
ANTHROPIC_API_KEY= # Claude 공식 SDK 인증 키; 기본 빈 값; 비밀
OPENAI_API_KEY= # OpenAI 공식 SDK 인증 키; 기본 빈 값; 비밀
GEMINI_API_KEY= # Gemini 공식 SDK 인증 키; 기본 빈 값; 비밀
LLM_MODE=live # 글쓰기 보조 live/fake/off; 기본 live; 비밀 아님

# DB·영속 파일·알림
NEO4J_URI=bolt://localhost:7687 # Neo4j Bolt 주소; 기본 bolt://localhost:7687; 비밀 아님
NEO4J_USER=neo4j # Neo4j 계정 이름; 기본 neo4j; 비밀 아님
NEO4J_PASSWORD= # Neo4j 암호; 코드 개발 기본 development-only, 운영은 반드시 변경; 비밀
DATA_DIR=.data # API·worker·collector·watchdog 공통 영속 경로; 기본 .data, 절대 경로 권장; 비밀 아님
REDIS_URL= # 선택적 Redis 알림 주소; 기본 없음; 인증을 포함하면 비밀
NEO4J_CONNECTION_TIMEOUT_SECONDS=3 # DB 연결 제한 초; 기본 3; 비밀 아님
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=5 # DB 연결 풀 대기 제한 초; 기본 5; 비밀 아님
NEO4J_TRANSACTION_RETRY_SECONDS=3 # DB 트랜잭션 재시도 시간 초; 기본 3; 비밀 아님
NEO4J_WRITE_TIMEOUT_SECONDS=5 # DB 쓰기 트랜잭션 제한 초; 기본 5; 비밀 아님
NEO4J_READ_TIMEOUT_SECONDS=30 # DB 읽기 트랜잭션 제한 초; 기본 30; 비밀 아님
AUTH_DB_TIMEOUT_SECONDS=8 # 인증 DB 작업 제한 초; 기본 8; 비밀 아님
MONITORING_WEBHOOK_URL= # 선택적 watchdog 알림 URL; 기본 없음; 비밀
WORKER_TENANTS= # worker가 처리할 tenant 쉼표 목록; 기본 빈 값, CLI --tenant 우선; 비밀 아님
ILDONGI_STRICT_TENANT=1 # tenant 없는 DB 쿼리 거절; 기본 미설정, 시험은 1; 비밀 아님
ILDONGI_TENANT_ID= # 평가 export tenant; 기본 없음, 명시 필요; 비밀 아님

# 인증·SSE·명시적 mock 장애 시험 (os.getenv: 실행 셸에서 export)
ILDONGI_DEV_PASSWORD= # 개발 계정 생성·E2E 암호; 코드 개발 기본 dev-only-change-me; 비밀
LOGIN_FAILURE_LIMIT=10 # 로그인 실패 잠금 건수; 기본 10; 비밀 아님
LOGIN_WINDOW_SECONDS=900 # 로그인 실패 집계 창 초; 기본 900; 비밀 아님
SSE_POLL_SECONDS=0.2 # SSE DB 폴링 주기 초; 기본 0.2; 비밀 아님
SSE_MAX_CONNECTIONS=100 # SSE 연결 한도; 기본 100; 비밀 아님
SSE_MAX_AFTER_AGE_SECONDS=604800 # SSE 재연결 cursor 최대 나이 초; 기본 604800; 비밀 아님
SSE_SESSION_RECHECK_SECONDS=15 # SSE 세션 재확인 초; 기본 15; 비밀 아님
AI_MOCK_DELAY_SECONDS=0 # mock 판단 지연 초; 기본 0; 비밀 아님
AI_MOCK_FAULT= # mock 장애 종류; 기본 없음; 비밀 아님
LLM_LIVE_TEST=0 # 유료 외부 LLM live 시험 명시 허용; 기본 미설정(skip); 비밀 아님

# E2E·인수 시험 실행기 (설정하지 않으면 각 실행기가 생성·선택)
E2E_TENANT=t-alpha # E2E 격리 tenant; 단독 UI 기본 t-alpha, 실행기 생성값 우선; 비밀 아님
E2E_BASE_URL=http://127.0.0.1:5173 # E2E 웹 주소; 실행기에서 필수 설정; 비밀 아님
E2E_API=http://127.0.0.1:8000 # E2E API 주소; 기본 http://127.0.0.1:8000; 비밀 아님
E2E_PORT=5173 # Playwright 웹 포트; 기본 5173; 비밀 아님
E2E_REQUESTER= # E2E 요청자 이메일; 기본 requester@선택tenant.dev; 비밀 아님
E2E_REQUEST_ID= # 재사용할 E2E 요청 ID; 기본 없음; 비밀 아님
E2E_REQUIRE_PARTIAL= # E2E에서 잠정 결과 필수 여부; 기본 미설정; 비밀 아님
E2E_LIVE_ATTEMPTS=4 # LIVE E2E 최대 시도; 기본 4; 비밀 아님
REAL_API= # Playwright 실제 API 사용 스위치; 기본 미설정; 비밀 아님
CI= # CI 모드(재시도·서버 재사용); 기본 미설정; 비밀 아님
VITE_CACHE_DIR= # Vite 시험 캐시 경로; 기본 Vite 기본 경로; 비밀 아님
ACC_TENANT= # 인수 시험 tenant; 실행기가 E2E_TENANT에서 설정; 비밀 아님
ACC_API= # 인수 시험 API; 실행기가 E2E_BASE_URL에서 설정; 비밀 아님
ACC_UI_OUT= # 인수 UI 증거 경로; 해당 실행기에서 필수; 비밀 아님
ACC_UI_JSON= # 인수 UI 결과 JSON 경로; 기본 없음; 비밀 아님
ACC_RECORDS= # 인수 시험 저장 기록 경로; 기본 없음; 비밀 아님
UX2_TENANT= # UX 시험 tenant; 실행기 생성값; 비밀 아님
UX2_OUT= # UX 시험 증거 경로; 기본은 실행기 참조; 비밀 아님
X38_TENANT= # 확장 시험 tenant; 실행기 생성값; 비밀 아님
X38_API= # 확장 시험 API 주소; 실행기가 E2E_BASE_URL에서 설정; 비밀 아님
X38_OUT= # 확장 시험 증거 경로; 실행기 생성값; 비밀 아님
X38_SUFFIX= # 확장 시험 데이터 식별 접미사; 실행기 ui1; 비밀 아님
X38_PHASE= # 확장 시험 단계; 기본 ui1 또는 r1(실행 suite별); 비밀 아님
X38_TRUTH= # 확장 시험 DB 정답 파일 단계; 기본 X38_PHASE; 비밀 아님
X38_SNAP=pre # 확장 시험 스냅샷 선택; 기본 pre; 비밀 아님
DEBUG_MEASURE=0 # UI 배치 측정 디버그; 기본 미설정; 비밀 아님
A11Y_SHOT_DIR= # 접근성 시험 스크린샷 경로; 기본은 실행기 참조; 비밀 아님
REM_SHOT_DIR= # 잔여 이슈 시험 스크린샷 경로; 기본은 실행기 참조; 비밀 아님
CHAT_SHOT_DIR= # 채팅 시험 스크린샷 경로; 기본은 실행기 참조; 비밀 아님
POLISH_SHOT_DIR= # UI 다듬기 시험 스크린샷 경로; 기본은 실행기 참조; 비밀 아님

# 시연·README 촬영 (기존 스크립트 설정만 문서화; 파일은 수정하지 않음)
DEMO_OUT= # 시연 증거 출력 경로; 실행기 생성값; 비밀 아님
DEMO_TENANT= # 시연 격리 tenant; 실행기 생성값; 비밀 아님
DEMO_COMMIT= # 시연 대상 소스 식별값; 기본 현재 소스; 비밀 아님
README_OUT= # README 촬영 출력 경로; 촬영 실행기에서 필수; 비밀 아님
README_TENANT= # README 촬영 격리 tenant; 촬영 실행기에서 필수; 비밀 아님

# 전용 부하 시험 환경 (공유 DB를 중지하지 않고 격리 실행)
T25_API_PORT=8125 # 부하 시험 API 포트; 기본 8125; 비밀 아님
T25_NEO4J_BOLT_PORT=7690 # 부하 시험 전용 Bolt 포트; 기본 7690; 비밀 아님
T25_NEO4J_DIR= # 부하 시험 Neo4j 데이터 경로; 실행기 생성값; 비밀 아님
T25_OUTPUT_ROOT=artifacts/validation/t25 # 부하 시험 출력 경로; 기본 artifacts/validation/t25; 비밀 아님
T25_COMPOSE_PROJECT=ildongi-t25 # 부하 시험 Compose 프로젝트; 기본 ildongi-t25; 비밀 아님

# Make 백업·복원 인자 (해당 명령에서 명시하고 실행 전 경로 확인)
BACKUP_DIR= # 백업 저장 경로; Make 기본 artifacts/backups/<UTC시각>; 비밀 아님
RESTORE_DATA_DIR= # 복원 대상 경로; 기본 없음, 비어 있는 경로 명시 필수; 비밀 아님
COMPOSE_PROJECT=ildongi-backup # 백업·복원 Compose 프로젝트; Make 기본 ildongi-backup; 비밀 아님
NEO4J_CONTAINER=ildongi-backup-neo4j-1 # 백업·복원 Neo4j 컨테이너; Make 기본 ildongi-backup-neo4j-1; 비밀 아님
NEO4J_BOLT_PORT=7689 # 백업·복원 Bolt 포트; Make 기본 7689; 비밀 아님
NEO4J_DATA_DIR=.data/neo4j # 백업할 Neo4j 볼륨 경로; Make 기본 저장소/.data/neo4j; 비밀 아님
RESTORE_NEO4J_DIR= # 복원 전용 Neo4j 경로; Make 기본 없음(복원 스크립트 파생 경로); 비밀 아님
ACC_TENANT_B= # 인수 격리 비교 tenant; 기본 ACC_TENANT 뒤에 b; 비밀 아님
ACC_PASSWORD= # 인수 시험 암호; 코드 개발 기본 dev-only-change-me; 비밀
ACC_OUT= # 인수 시험 결과 경로; 기본 없음; 비밀 아님
ACC_ENV_OUT= # 재시작 인수 환경 기록 경로; 기본 없음; 비밀 아님
ACC_SKIP_UI= # 인수 UI 시험 생략(1); 기본 미설정(UI 포함); 비밀 아님
X38_RUN= # 확장 인수 시나리오 수집 허용(1); 기본 미설정(skip); 비밀 아님
RETENTION_ARGS= # Make retention 추가 CLI 인자; 기본 없음; 비밀 아님
