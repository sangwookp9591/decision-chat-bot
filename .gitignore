.env
.data/
backend/.venv/
frontend/node_modules/
frontend/dist/
artifacts/validation/*/raw/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Runtime data and large raw logs produced by validation runs (reports stay tracked)
artifacts/validation/**/data/
artifacts/validation/**/*.db
artifacts/validation/**/*.log
artifacts/validation/**/test-results/
# Large raw load-test samples are kept locally only (summaries/REPORT.md are tracked)
artifacts/validation/t25*/**/sse.csv
artifacts/validation/t25*/**/runs.json
frontend/test-results/
frontend/playwright-report/
frontend/tsconfig.tsbuildinfo
# Ad-hoc E2E run logs
artifacts/*-e2e/
artifacts/demo/**/*.webm
artifacts/demo/**/*.mp4
artifacts/demo/**/raw/
artifacts/review/completeness/scratch/data/
# full E2E run outputs (traces, screenshots, run data) stay local; only the report and summaries are committed
artifacts/review/e2e-all/**
!artifacts/review/e2e-all/*.md
!artifacts/review/e2e-all/*.json
!artifacts/review/e2e-all/*.log
!artifacts/review/e2e-all/20261005T152719/
!artifacts/review/e2e-all/20261005T152719/extension/
!artifacts/review/e2e-all/20261005T152719/extension/*.json
!artifacts/review/e2e-all/20261005T160522/
!artifacts/review/e2e-all/20261005T160522/results.*
# QA run outputs (traces, run data) stay local; reports, repro tests, logs and key captures are committed
artifacts/review/qa-full/*/runs/
artifacts/review/qa-full/*/runtime/
artifacts/review/qa-full/**/trace.zip
artifacts/review/qa-full/**/data/
artifacts/review/qa-full/**/*.webm

# Final regression raw browser/runtime evidence stays local.
artifacts/review/final-regression/**
!artifacts/review/final-regression/*.md
